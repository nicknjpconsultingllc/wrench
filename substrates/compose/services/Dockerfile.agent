# The sandbox: python + wrenchctl and nothing else. Non-root, no docker
# client, no compose files, no source of any other service.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
COPY wrenchctl/ /src/wrenchctl/
RUN pip install --no-deps /src/wrenchctl && rm -rf /src
RUN groupadd -g 10001 agent && useradd -m -u 10001 -g 10001 -s /bin/bash agent
USER agent
WORKDIR /home/agent
CMD ["sleep", "infinity"]
